# Domain registered with Anywear (Decart). The widget script is loaded from
# https://anywear.decart.ai/widget/latest/anywear.js?domain=<this value>.
# Falls back to window.location.hostname when unset.
VITE_ANYWEAR_DOMAIN=fashion-e-commerce-aqgt.onrender.com

# Existing app API settings (included so a fresh checkout can run locally).
# Consumers append paths such as /products, so keep the /api suffix.
VITE_API_BASE_URL=http://localhost:5000/api
VITE_APP_BASE_URL=http://localhost:5000
